{
  "name": "ri-chang",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Everyday Mandarin for real conversations — a local-first Mac desktop app.",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && node scripts/serve.cjs",
    "preview": "npm run build && open src/index.html",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:mac": "npm run build && electron-packager . 'Richang' --platform=darwin --arch=arm64 --out=dist --overwrite --ignore='^/(test|scripts|dist|screenshots)' --extend-info=electron/Info.plist"
  },
  "devDependencies": {
    "electron": "latest",
    "@electron/packager": "latest"
  }
}
